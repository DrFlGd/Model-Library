{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Model Library",
  "version": "0.2.0",
  "identifier": "io.github.drflgd.modellibrary",
  "build": {
    "frontendDist": "../../build/desktop/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Model Library",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Organise large collections of 3D model files",
    "longDescription": "Organise thousands of 3D model files (STL, 3MF, slicer projects and more) into a folder library laid out by your own schemas, with their details, pictures and documents kept beside them.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
